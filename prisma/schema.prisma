// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  parentId    String?  @db.ObjectId
  isActive    Boolean  @default(true)
  isApproved  Boolean  @default(false)
  createdBy   String   // userId veya "admin"
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryToCategory")
  posts Post[]
  businesses Business[]
}
model Post {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  price      Int
  images     String[]
  address    String
  city       String
  district   String?
  phoneNumber   String?
  latitude   String
  longitude  String
  businessName  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @db.ObjectId
  postDetail PostDetail?
  savedPosts SavedPost[]
  approved  Boolean?  @default(false)
  comments   Comment[]
  listingType String @default("standard")
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  adDuration    Int
  startDate     DateTime?
  expireDate    DateTime?

  // Kampanya, bir işletme profiline bağlıysa (işyeri hesabı ekledi ise otomatik)
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessId    String?   @db.ObjectId

  @@index([businessId])
}

enum Type {
  buy
  rent
}

enum Property {
  apartment
  house
  condo
  land
}

model PostDetail {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  desc       String?
  campaignDuration  String?
  discountAmount    String?
  income     String?
  size       Int?
  school     Int?
  bus        Int?
  restaurant Int?
  post       Post    @relation(fields: [postId], references: [id])
  postId     String  @unique @db.ObjectId
}

model SavedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  // ⚠️ userId/postId üzerinde AYRI AYRI @unique OLMAMALI: bu, bir kullanıcının
  // sistemde toplamda sadece 1 kayıtlı ilanı, bir ilanın da toplamda sadece
  // 1 kullanıcı tarafından kaydedilebilmesi anlamına gelir (favoriler özelliğini
  // fiilen kırar). Doğru kısıt, aşağıdaki bileşik @@unique([userId, postId]).
  userId    String   @db.ObjectId
  postId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  email      String      @unique
  username   String      @unique
  password   String
  city   String
  district   String
  role       String      @default("user")
  type   String ?
  avatar     String?
  createdAt  DateTime    @default(now())
  posts      Post[]
  savedPosts SavedPost[]
  chats      Chat[]      @relation(fields: [chatIDs], references: [id])
  chatIDs    String[]    @db.ObjectId
  resetToken        String?   
  resetTokenExpiry  DateTime?
   comments   Comment[] 
   phone      String? @unique

  // İşletme dizini / özel soru-cevap
  business          Business?         @relation("BusinessOwner")
  businessReviews   BusinessReview[]  @relation("ReviewAuthor")
  inquiriesSent     Inquiry[]         @relation("InquiryCustomer")
  inquiriesReceived Inquiry[]         @relation("InquiryOwner")
  inquiryMessages   InquiryMessage[]
  favoriteBusinesses BusinessFavorite[]
}

model Chat {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  users     User[]    @relation(fields: [userIDs], references: [id])
  userIDs   String[]  @db.ObjectId
  createdAt DateTime  @default(now())
  seenBy    String[]  @db.ObjectId
  messages  Message[]
  lastMessage String?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  phone   String
  createdAt DateTime @default(now())
}

// ==================== İŞLETME DİZİNİ ====================

// İşyeri hesabı (role: "business") başına en fazla 1 işletme profili.
model Business {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  owner        User     @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String   @unique @db.ObjectId
  name         String
  category     Category @relation(fields: [categoryId], references: [id])
  categoryId   String   @db.ObjectId
  description  String?
  address      String
  city         String
  district     String
  phone        String
  website      String?
  workingHours String?
  logo         String?
  photos       String[]
  isActive     Boolean  @default(true)
  // Her yorum eklenip silindiğinde yeniden hesaplanır (listeleme/sıralama hızlı olsun diye)
  ratingAvg    Float    @default(0)
  ratingCount  Int      @default(0)
  // Yönetici tarafından verilen "Doğrulanmış işletme" rozeti.
  // ⚠️ Bilerek `Boolean?`: MongoDB'de mevcut kayıtlarda bu alan yok; zorunlu
  // (non-null) tanımlansaydı Prisma eski işletmeleri okurken hata verirdi.
  isVerified   Boolean? @default(false)
  // Öne çıkarılan işletme (yönetici verir; featuredUntil geçince otomatik düşer)
  isFeatured   Boolean? @default(false)
  featuredUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews    BusinessReview[]
  inquiries  Inquiry[]
  posts      Post[]
  favorites  BusinessFavorite[]
  dailyStats BusinessDailyStat[]

  @@index([city, district])
  @@index([categoryId])
}

// Herkese açık yorum/puan. Kullanıcı başına işletme başına tek yorum.
model BusinessReview {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @db.ObjectId
  user       User     @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId
  rating     Int
  comment    String?
  // İşletme sahibinin yoruma verdiği herkese açık yanıt
  ownerReply   String?
  ownerReplyAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId, createdAt])
}

// Özel soru-cevap: sadece müşteri ile işletme sahibi görür.
model Inquiry {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String   @db.ObjectId
  customer       User     @relation("InquiryCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String   @db.ObjectId
  owner          User     @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String   @db.ObjectId
  subject        String
  // "open" (işletmenin yanıtı bekleniyor) | "answered" | "closed"
  status         String   @default("open")
  ownerUnread    Boolean  @default(true)
  customerUnread Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages InquiryMessage[]

  @@index([ownerId, updatedAt])
  @@index([customerId, updatedAt])
  @@index([businessId])
}

model InquiryMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId String   @db.ObjectId
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String   @db.ObjectId
  text      String
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

// Kullanıcının favori işletmeleri
model BusinessFavorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @db.ObjectId
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([userId, createdAt])
}

// Günlük sayaçlar (profil görüntüleme, arama, yol tarifi). Kişisel veri tutmaz.
model BusinessDailyStat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @db.ObjectId
  // "2026-10-02" (Türkiye saatine göre)
  date       String
  views      Int      @default(0)
  calls      Int      @default(0)
  directions Int      @default(0)

  @@unique([businessId, date])
}
