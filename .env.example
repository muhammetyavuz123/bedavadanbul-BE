# MongoDB bağlantı adresi (yerel ya da MongoDB Atlas)
DATABASE_URL=mongodb://localhost:27017/Databases

# JWT için rastgele, uzun ve tahmin edilemez bir değer kullanın.
# Örn. terminalde şu şekilde üretebilirsiniz:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend'in production URL'i (şifre sıfırlama linkleri için kullanılıyor)
CLIENT_URL=https://www.example.com/

NODE_ENV=development

# SMTP (şifre sıfırlama e-postaları için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hosting platformu (Railway/Render vb.) genelde kendi PORT değerini enjekte eder.
# Yerelde boş bırakılırsa 8800 kullanılır.
PORT=8800
